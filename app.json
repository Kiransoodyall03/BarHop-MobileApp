{
  "expo": {
    "name": "BarHop-MobileApp",
    "slug": "BarHop-MobileApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "barhop",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#120B14",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.barhop.mobile",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDUhd9QPtzOIivCoiYS2L18QjjQlumwh5I"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BarHop uses your location to show you bars and clubs nearby."
        }
      ],
      "expo-video",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6244997531055231~8473860699",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "./plugins/withGoogleAdsKotlinFix",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "165d6792-0f61-49a0-9fec-b8430ad7be17"
      }
    }
  }
}
