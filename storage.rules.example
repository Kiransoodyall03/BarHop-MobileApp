// ─────────────────────────────────────────────────────────────────────────────
// Firebase Storage security rules — BarHop consumer mobile app avatars.
//
// ⚠️  Lives in the same shared Firebase project as firestore.rules.example.
// Deploy from the Creator webapp repo or paste into Firebase console →
// Storage → Rules. Storage itself must be enabled for this project first
// (console → Storage → "Get started") — it is not auto-provisioned.
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile pictures — one fixed object per user (avatars/{uid}.jpg),
    // overwritten on change. Any signed-in user may read any avatar (they're
    // shown to squadmates via denormalized memberPhotos on the squad doc,
    // same read posture as a display name); only the owning uid may write
    // their own file.
    //
    // ⚠️  The wildcard captures the WHOLE filename and the extension is checked
    // in the condition. `match /avatars/{uid}.jpg` looks natural but is a
    // syntax error — a wildcard must occupy an entire path segment, so a
    // literal suffix after `}` fails to parse ("Unexpected '.'").
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
