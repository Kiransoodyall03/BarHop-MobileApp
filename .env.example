# Copy this file to .env and fill in real values. EXPO_PUBLIC_* vars are
# inlined into the app bundle at build time — restart `expo start` after edits.

# ── Firebase (SAME project as the BarHop Creator webapp) ────────────────────
# Firebase console → Project settings → General → Your apps → Web app config.
# If no Web app is registered yet, add one ("</>") — no hosting needed.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── AdMob (optional — dev builds fall back to Google's TEST ad units) ───────
# Create real ad units in the AdMob console before release, and replace the
# TEST App IDs in app.json (plugins → react-native-google-mobile-ads) with
# your real ones. Ads are disabled automatically in Expo Go.
EXPO_PUBLIC_ADMOB_NATIVE_AD_UNIT=
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT=

# ── Sentry (crash + error reporting) ────────────────────────────────────────
# Create a React Native project at sentry.io → Settings → Client Keys (DSN).
# Leave blank and reporting stays fully off (the app runs identically). Set it
# and eas env:push so release builds report crashes.
EXPO_PUBLIC_SENTRY_DSN=

# ── RevenueCat (consumer Pro subscription, via Google Play Billing) ─────────
# RevenueCat dashboard → Project settings → API keys → the ANDROID public SDK
# key (starts "goog_"). Consumer subs MUST go through Play Billing — Paystack
# is the B2B venue flow on the Creator webapp and is not permitted in-app.
# Leave blank and the paywall shows a graceful "unavailable" state.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ── Creator webapp claim link ───────────────────────────────────────────────
# Signup URL on the B2B Creator webapp. Auto-created ("Unclaimed") venue cards
# show a "Own this business? Claim it" CTA that opens this with the venue's
# Foursquare place ID appended as ?fsq=<placeId>, so the owner lands on signup
# with their venue pre-selected. Leave blank to hide the CTA entirely.
EXPO_PUBLIC_CREATOR_CLAIM_URL=

# ── Google Sign-In (optional until you make a development build) ────────────
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# The Web client ID usually already exists (Firebase creates it when you
# enable the Google sign-in provider). Leave blank to keep the Google button
# in "not configured" mode — email/password auth works without any of these.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
